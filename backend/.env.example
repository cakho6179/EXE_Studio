# ==============================================================================
# Stuđiô AI — File cấu hình môi trường (.env)
# Sao chép file này thành .env trong thư mục backend: `copy .env.example .env`
# ==============================================================================

PROJECT_NAME="Stuđiô AI"
API_V1_STR="/api/v1"
ENV="development" # Đổi thành "production" khi đưa lên máy chủ thật

# 1. Khóa bí mật ký JWT Token (Bắt buộc tối thiểu 32 ký tự theo chuẩn RFC 7518)
SECRET_KEY="studi-ai-secret-key-for-jwt-super-calm-tech-academic-sanctuary"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 2. CƠ SỞ DỮ LIỆU (DATABASE)
# Mặc định Local: Dùng SQLite file cục bộ
DATABASE_URL="sqlite:///./studi_ai.db"

# Đưa lên Server thật (PostgreSQL Cloud miễn phí từ Neon, Supabase, Render, Railway):
# DATABASE_URL="postgresql://username:password@ep-cool-sample.ap-southeast-1.neon.tech/studi_ai?sslmode=require"

# 3. GOOGLE GEMINI AI
GEMINI_API_KEY="AIzaSyDcIoUJHsLeOpAeKYiYFTEFjtUGLxZdmEQ"
GEMINI_MODEL="gemini-3.5-flash-lite"

# 4. CẤU HÌNH GỬI EMAIL OTP THẬT (SMTP)
# Nếu để trống: Hệ thống chạy Chế độ Demo (in OTP ra terminal và tự điền trên giao diện web)
# Để gửi email thật đến Gmail/Outlook của sinh viên, điền thông tin sau (Khuyên dùng Gmail):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
# Mật khẩu ứng dụng 16 chữ số của Google (Google App Password, không phải mật khẩu tài khoản)
# Cách lấy: Tài khoản Google -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng -> Tạo mới
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM="Stuđiô AI <your_email@gmail.com>"

# Chế độ demo: trả dev_code trong response API để tự điền (Đặt false ở production thật)
OTP_RETURN_DEV_CODE=true

# 5. GOOGLE SIGN-IN IDENTITY (Tùy chọn)
GOOGLE_CLIENT_ID=""
