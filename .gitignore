# Stuđiô AI — 1 file gitignore duy nhất cho cả repo.
# Quy tắc: không commit secret, lib, build output, DB local, file tạm.

# --- Secrets & môi trường ---
.env
backend/.env
*.local

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
backend/env/
backend/uploads/
*.db
*.db-journal
*.sqlite3

# --- Node / Frontend (1 thư mục frontend/ duy nhất) ---
node_modules/
frontend/app/
frontend/dist/
frontend/dist-ssr/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Tạm & docs nháp ---
temp/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
